# ─── Database ───
DATABASE_URL="postgresql://blog:blog@localhost:5432/blog"

# ─── Auth.js ───
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GITHUB_ID="your-github-oauth-app-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-secret"

# ─── Garage (S3) ───
S3_ENDPOINT="https://s3-new.dokploy.creco.dev"
S3_ACCESS_KEY="your-garage-access-key"
S3_SECRET_KEY="your-garage-secret-key"
# 업로드한 이미지를 읽는 공개 주소(Garage 웹 엔드포인트). 비우면 S3_ENDPOINT/blog-images 를 쓴다
S3_PUBLIC_URL="https://blog-images.dokploy.creco.dev"

# ─── Upload ───
UPLOAD_MAX_FILE_SIZE_MB=10

# ─── App ───
NEXTAUTH_URL="http://localhost:3000"
